# Settings for the optional /admin/ editor (Cloud Functions params).
# `npm run deploy:functions` copies this file to functions/.env.<firebaseProject>.
# GitHub repo holding this content (owner/name), and the branch the site deploys from.
GITHUB_REPO=your-github-user/your-band-content
GITHUB_BRANCH=main
# Google accounts allowed to edit, comma-separated.
ADMIN_EMAILS=you@example.com,bandmate@example.com
